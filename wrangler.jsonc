{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mubbie-personal-site",
  "main": "workers/index.js",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Only mubbie.dev (behind Cloudflare Access for /admin) serves this Worker: no
  // *.workers.dev address and no preview URLs that would skip Access.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // These paths always go to the Worker. Listing any path here means unlisted ones are
    // served from assets only, so the APIs must be listed too. /admin/* must pass the
    // Worker's auth check and never be served straight from assets.
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  // Public, not secret. Paired with the TURNSTILE_SECRET secret; without both the guestbook stays closed.
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFqZRZk7emqQPEBa",
    // Guestbook alerts: sent from this address on mubbie.dev to the verified destination below
    "NOTIFY_FROM": "guestbook@mubbie.dev",
    "NOTIFY_TO": "midoko.dev@gmail.com",
    // Cloudflare Access guards /admin/* and /api/guestbook/admin* (Zero Trust → Access →
    // "mubbie.dev guestbook admin"). Public identifiers, not secrets: the Worker checks the
    // sign-in it receives was issued by this team for this app.
    "ACCESS_TEAM_DOMAIN": "mubbie.cloudflareaccess.com",
    "ACCESS_AUD": "3044d66ada72f8b99e5f7633ee2c895092158297c601f94041c242115bbdd3fa"
  },
  // Workers AI: Llama Guard screens guestbook notes (free tier). Without it, notes still get human review.
  "ai": {
    "binding": "AI"
  },
  // Email when a guestbook note is waiting. Needs Email Routing on for mubbie.dev (its DNS
  // records added) and the destination verified in Email Routing → Destination addresses.
  "send_email": [{ "name": "GUESTBOOK_EMAIL", "destination_address": "midoko.dev@gmail.com" }],
  "kv_namespaces": [
    {
      "binding": "POSTS_CACHE",
      "id": "6654a5496ff24969a583260e6d31c31c"
    }
  ]
}
